{
    "id": "garra-kbd-layout",
    "name": "Keyboard Layout (garra)",
    "version": "1.2.0",
    "minNoctaliaVersion": "4.7.0",
    "author": "garra",
    "license": "MIT",
    "description": "Shows the active keyboard layout in the bar. Correctly distinguishes us/intl from us/altgr-intl. Supports per-layout custom labels and flag icons.",
    "tags": ["Bar", "Niri"],
    "entryPoints": {
        "barWidget": "BarWidget.qml",
        "settings": "Settings.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "defaultSettings": {
            "showText": true,
            "iconMode": "generic",
            "customLabels": {}
        }
    }
}
